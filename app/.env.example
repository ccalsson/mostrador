# Copiar a `.env` (no versionado) y completar. `node scripts/with-app-env.mjs`
# y `node scripts/migrate.mjs` lo cargan solos; en deploy lo inyecta la plataforma.

# PostgreSQL DEV (Neon, rama dev). Sin valor => PGlite local efímero.
# Ej: postgresql://usuario:clave@ep-xxx.us-east-2.aws.neon.tech/mostrador?sslmode=require
DATABASE_URL=

# Obligatorio cuando hay DATABASE_URL: firma las sesiones de Better Auth.
# Generar: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# NUNCA hardcodear ni versionar el valor real.
BETTER_AUTH_SECRET=

# Origen público canónico (mismo origen que repoweb); requerido para callbacks OAuth.
BETTER_AUTH_URL=

# Credenciales OAuth del cliente registrado con el broker compartido.
# Callback público esperado: <BETTER_AUTH_URL>/api/auth/oauth2/callback/grok-google
# (y grok-x). No versionar los valores reales.
GROK_AUTH_ISSUER=https://auth.grok.me
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# true sólo en DEV: siembra catálogo, clientes y cuentas demo (incluye staff).
# En producción dejar ausente/false: sin staff no hay auto-alta; el primer admin
# se provisiona a mano (insert en `staff` o vía Usuarios con una sesión admin).
SEED_DEMO=

# Resend: correo transaccional (confirmación de alta, recuperación).
# Sin esta key, el gate de confirmación de Mercado se deshabilita automáticamente
# (opción B): las cuentas nuevas no requieren confirmar correo hasta que se
# configure Resend en el entorno. En DEV local se puede usar un valor fake
# (re_...) para forzar el gate y probar el flujo; el envío real falla pero el
# enlace de confirmación queda en la respuesta.
RESEND_API_KEY=
RESEND_FROM=
