# Copiar a `.env` (no versionado) y completar. `node scripts/with-app-env.mjs`
# y `node scripts/migrate.mjs` lo cargan solos; en deploy lo inyecta la plataforma.

# PostgreSQL DEV (Neon, rama dev). Sin valor => PGlite local efímero.
# Ej: postgresql://usuario:clave@ep-xxx.us-east-2.aws.neon.tech/mostrador?sslmode=require
DATABASE_URL=

# Obligatorio cuando hay DATABASE_URL: firma las sesiones de Better Auth.
# Generar: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# NUNCA hardcodear ni versionar el valor real.
BETTER_AUTH_SECRET=

# true sólo en DEV: siembra catálogo, clientes y cuentas demo (incluye staff).
# En producción dejar ausente/false: sin staff no hay auto-alta; el primer admin
# se provisiona a mano (insert en `staff` o vía Usuarios con una sesión admin).
SEED_DEMO=
